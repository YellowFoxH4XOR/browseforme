{
  "manifest_version": 3,
  "name": "BrowseForMe Bridge",
  "version": "1.0.0",
  "description": "Grants individual tabs to the local BrowseForMe daemon.",
  "permissions": ["tabs", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
